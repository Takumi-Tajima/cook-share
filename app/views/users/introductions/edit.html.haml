.mx-auto.max-w-6xl.p-4
  .card.bg-base-100.shadow-sm
    .card-body
      %h1.card-title.text-xl.mb-4 プロフィール編集

      = simple_form_for current_user, url: users_introduction_path, method: :patch do |f|
        = f.error_notification
        = f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present?

        = f.input :name
        = f.input :introduction, input_html: { rows: 5, class: 'textarea' }
        = f.input :profile_image

        .card-actions.justify-between.mt-5
          = link_to 'キャンセル', users_introduction_path, class: 'btn btn-ghost'
          = f.button :submit, '保存', class: 'btn btn-primary'
