.mx-auto.max-w-6xl.p-4
  .card.bg-base-100.shadow-sm
    .card-body
      %h1.card-title.text-xl.mb-4 アカウント編集

      = simple_form_for current_user, url: users_authentication_path, method: :patch do |f|
        = f.error_notification
        = f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present?

        = f.input :email
        = f.input :current_password
        = f.input :password, hint: '変更しない場合は空欄のままにしてください', label: '新しいパスワード'
        = f.input :password_confirmation

        .card-actions.justify-between.mt-5
          = link_to 'キャンセル', users_introduction_path, class: 'btn btn-ghost'
          = f.button :submit, '保存', class: 'btn btn-primary'
