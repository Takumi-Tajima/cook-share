.flex.justify-between.items-center.mb-6
  %h1.text-3xl.font-bold Myレシピ一覧
  = link_to '新規作成', new_users_recipe_path, class: 'btn btn-primary'

%table.table
  %thead
    %tr
      %th タイトル
      %th カテゴリ
      %th 調理時間
      %th 難易度
      %th 公開ステータス
  %tbody
    - @recipes.each do |recipe|
      %tr
        %td= link_to recipe.title, users_recipe_path(recipe), class: 'text-blue-600 hover:underline'
        %td= recipe.category.name
        %td= "#{recipe.cooking_time}分"
        %td= recipe.difficulty_text
        %td= recipe.published? ? '公開' : '非公開'
