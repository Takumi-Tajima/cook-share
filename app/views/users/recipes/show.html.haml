.card.bg-base-100.shadow-xl.max-w-2xl.mx-auto
  .card-body
    %h1.card-title.text-3xl= @recipe.title

    .divider

    %p.text-lg= @recipe.description

    .grid.grid-cols-3.mt-4
      %strong.text-sm カテゴリー:#{@recipe.category.name}
      %strong.text-sm 調理時間:#{@recipe.cooking_time}分
      %strong.text-sm 難易度:#{@recipe.difficulty_text}
      %strong.text-sm 公開ステータス:#{@recipe.published? ? '公開' : '非公開'}

    .card-actions.justify-end.mt-6
      = link_to '編集', edit_users_recipe_path(@recipe), class: 'btn btn-accent'
      = link_to '一覧に戻る', users_recipes_path, class: 'btn btn-outline'
